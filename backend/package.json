{
  "name": "flick-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc",
    "test": "node --test 'src/**/*.test.ts'",
    "check": "node --env-file-if-exists=.env scripts/check.ts",
    "loop": "node --env-file-if-exists=.env scripts/loop.ts",
    "api": "node --env-file-if-exists=.env scripts/api.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
