{
  "name": "flick-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx watch --import dotenv/config src/server.ts",
    "start": "tsx --import dotenv/config src/server.ts",
    "typecheck": "tsc",
    "test": "tsx --test 'src/**/*.test.ts'",
    "check": "tsx --env-file-if-exists=.env scripts/check.ts",
    "loop": "tsx --env-file-if-exists=.env scripts/loop.ts",
    "api": "tsx --env-file-if-exists=.env scripts/api.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}