# Copy to backend/.env (git-ignored), fill in, then run `npm run check` to test each service.
# Variables already set in your shell win over this file.

# --- PayPal sandbox -----------------------------------------------------------------------
# From a sandbox REST app: developer.paypal.com → Apps & Credentials → Sandbox → your app.
# Under the app's Features, turn on: Accept payments, Payouts, Invoicing, Transaction search.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Where the frontend runs. PayPal sends people back here after they approve a payment.
# Default http://localhost:3000; set it to your public URL when deployed.
FRONTEND_URL=

# --- AI (Lens, Nudge drafts, the Money Studio assistant) -----------------------------------
# Any OpenAI-compatible API. OpenRouter by default (openrouter.ai/keys); for OpenAI, set
# AI_BASE_URL=https://api.openai.com/v1 and pick an OpenAI model below.
AI_API_KEY=
AI_BASE_URL=

# The model Lens and Nudge use. It must read images and support structured outputs.
# List fallbacks after it, comma-separated: on OpenRouter, they're used when the first is rate-limited
# or down. Default google/gemini-2.5-flash.
AI_MODEL=

# Model ids the Money Studio assistant may use, comma-separated, the first the default.
# Default: AI_MODEL. The assistant needs the provider's Responses API (/responses).
STUDIO_MODELS=

# --- Server --------------------------------------------------------------------------------
# Port (default 4000), and where Flick keeps its data (default backend/.data/state.json).
PORT=
STATE_FILE=

# Calls to the AI per hour, across everyone (default 300). It keeps a public demo from draining the key.
AI_HOURLY_LIMIT=

# Optional: Scout's real online prices, from Channel3's product search (free tier: 1,000 searches a
# month). Get a key at https://channel3.ai. Without it, Scout prices only its sandbox stores.
CHANNEL3_API_KEY=
